<Application x:Class="EyeRest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>

        <!-- ===== 动漫花边装饰（矢量，可在各窗口复用） ===== -->
        <!-- 樱花（粉） -->
        <DrawingImage x:Key="SakuraPink">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F7BFD3">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="0"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="72"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="144"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="216"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="288"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F28FB3"><GeometryDrawing.Geometry><EllipseGeometry Center="0,0" RadiusX="7" RadiusY="7"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 樱花（浅粉白） -->
        <DrawingImage x:Key="SakuraSoft">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FCE4EC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="0"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="72"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="144"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="216"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                                <PathGeometry><PathGeometry.Transform><RotateTransform Angle="288"/></PathGeometry.Transform><PathFigure StartPoint="0,0"><BezierSegment Point1="-12,-10" Point2="-15,-28" Point3="0,-36"/><BezierSegment Point1="15,-28" Point2="12,-10" Point3="0,0"/></PathFigure></PathGeometry>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F8BBD0"><GeometryDrawing.Geometry><EllipseGeometry Center="0,0" RadiusX="7" RadiusY="7"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 四角闪光星 -->
        <DrawingImage x:Key="Sparkle">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#F6D77A">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,-26" IsClosed="True" IsFilled="True">
                                <LineSegment Point="6,-6"/>
                                <LineSegment Point="26,0"/>
                                <LineSegment Point="6,6"/>
                                <LineSegment Point="0,26"/>
                                <LineSegment Point="-6,6"/>
                                <LineSegment Point="-26,0"/>
                                <LineSegment Point="-6,-6"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 绿叶 -->
        <DrawingImage x:Key="LeafDeco">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#7CC093">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0">
                                <BezierSegment Point1="13,-20" Point2="39,-25" Point3="53,-9"/>
                                <BezierSegment Point1="39,5" Point2="14,9" Point3="0,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== 全局文字：统一字体 + 锐利渲染（ClearType + Display，消除发虚） ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
    </Application.Resources>
</Application>
