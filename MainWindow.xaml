<Window x:Class="EyeRest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="护眼助手" Width="920" Height="640" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F5F7F2">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18342A"/>
        <SolidColorBrush x:Key="Muted" Color="#738079"/>
        <SolidColorBrush x:Key="Green" Color="#2D7A59"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#18342A"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#EAF0EB"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F3F6F2"/>
            <Setter Property="BorderBrush" Value="#DDE6DF"/>
        </Style>
    </Window.Resources>

    <Grid Margin="38,28,38,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,24">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="护眼助手" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="定时离开屏幕，让眼睛看向远处" Margin="0,7,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E5F1E8" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#2D7A59" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="专注中" Foreground="#2D7A59" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="#EFF5F0" CornerRadius="46" Width="92" Height="92" Padding="10">
                            <Image Source="assets/brand/eye-rest-icon.png" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="距离下次休息" Margin="0,24,0,8" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountdownText" Text="20:00" FontFamily="Segoe UI Variable Display" FontSize="61" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CycleText" Text="每 20 分钟休息 20 秒" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="ToggleButton" Content="暂停计时" Style="{StaticResource PrimaryButton}" Click="ToggleButton_Click"/>
                        <Button Grid.Column="2" Content="重新计时" Style="{StaticResource GhostButton}" Click="ResetButton_Click"/>
                    </Grid>
                    <Button Grid.Row="2" Content="现在休息一下" Background="Transparent" BorderThickness="0" Foreground="#2D7A59" FontWeight="SemiBold" Padding="8" Click="BreakNowButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}" Background="#E9F3EC" Padding="22" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="20 · 20 · 20 护眼法" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="每使用屏幕 20 分钟，眺望 20 英尺（约 6 米）以外，至少 20 秒。" Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#52685F"/>
                        <TextBlock Text="坚持远眺能帮助眼睛放松调焦肌肉，减轻长时间近距离用眼带来的疲劳。" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#7A8A82"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="时间设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="专注时长" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                                <ComboBox x:Name="WorkMinutesBox" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Tag="1">1 分钟（测试）</ComboBoxItem>
                                    <ComboBoxItem Tag="20">20 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="30">30 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="45">45 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="60">60 分钟</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="休息时长" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                                <ComboBox x:Name="BreakSecondsBox" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Tag="20">20 秒</ComboBoxItem>
                                    <ComboBoxItem Tag="30">30 秒</ComboBoxItem>
                                    <ComboBoxItem Tag="60">1 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="300">5 分钟</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#E7ECE8" Margin="0,20,0,16"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Windows 开机后自动启动" Foreground="{StaticResource Ink}" FontSize="14"
                                  Checked="Automation_Changed" Unchecked="Automation_Changed"/>
                        <CheckBox x:Name="ScheduleEnabledCheck" Content="仅在设定时间段工作" Margin="0,12,0,0" Foreground="{StaticResource Ink}" FontSize="14"
                                  Checked="Automation_Changed" Unchecked="Automation_Changed"/>
                        <Grid x:Name="SchedulePanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ActiveStartHourBox" SelectionChanged="Automation_Changed"/>
                            <TextBlock Grid.Column="1" Text="至" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ActiveEndHourBox" Grid.Column="2" SelectionChanged="Automation_Changed"/>
                        </Grid>
                        <TextBlock Text="结束后进入睡眠时段，到开始时间自动重新计时" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11" Foreground="#89948E"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="休息画面" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="ImageStatusText" Text="自然渐变背景" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="恢复默认" Background="Transparent" BorderThickness="0" Foreground="#708077" Click="DefaultImageButton_Click"/>
                        </Grid>
                        <Border Height="122" CornerRadius="16" Margin="0,16,0,14" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PreviewBackground">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#173C35" Offset="0"/><GradientStop Color="#5B9B73" Offset="0.55"/><GradientStop Color="#D2B67C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="PreviewHint" Text="让视线去远方" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Content="选择自己的图片" Style="{StaticResource GhostButton}" Click="ChooseImageButton_Click"/>
                        <TextBlock Text="支持 JPG、PNG、BMP；图片会铺满休息屏幕" Margin="2,10,0,0" FontSize="11" Foreground="#89948E"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
