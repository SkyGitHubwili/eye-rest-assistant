<Window x:Class="EyeRest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="护眼助手" Width="920" Height="640" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
            <GradientStop Color="#F7FAF4" Offset="0"/>
            <GradientStop Color="#EDF4EE" Offset="0.55"/>
            <GradientStop Color="#F4F0E8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#16352A"/>
        <SolidColorBrush x:Key="Muted" Color="#728079"/>
        <SolidColorBrush x:Key="Green" Color="#2D7A59"/>

        <!-- 卡片：细腻边框 + 柔和阴影 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="BorderBrush" Value="#EAF0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.10" Color="#18342A"/></Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：绿色渐变 + 悬停/按压缩放 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3E916A" Offset="0"/>
                        <GradientStop Color="#266D4F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#18342A"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.04" ScaleY="1.04"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：浅绿灰渐变 -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F1F5F1" Offset="0"/>
                        <GradientStop Color="#E3EBE4" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F3F6F2"/>
            <Setter Property="BorderBrush" Value="#DDE6DF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="50,36,50,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="4,0,4,24">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="护眼助手" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <Image Source="{StaticResource LeafDeco}" Width="26" Margin="9,3,0,0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><RotateTransform Angle="-18"/></Image.RenderTransform>
                        </Image>
                    </StackPanel>
                    <TextBlock Text="定时离开屏幕，让眼睛看向远处" Margin="0,7,0,0" FontSize="14" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E5F1E8" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#2D7A59" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="专注中" Foreground="#2D7A59" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F6FAF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#EAF3EC" CornerRadius="46" Width="96" Height="96" Padding="6">
                                <Viewbox>
                                    <Canvas Width="1024" Height="1024">
                                        <Rectangle Canvas.Left="32" Canvas.Top="32" Width="960" Height="960" RadiusX="224" RadiusY="224">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#143D36" Offset="0"/>
                                                    <GradientStop Color="#4AA977" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Path Data="M142 305A402 402 0 0 1 305 142" Stroke="#3FDDF2E5" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M882 719A402 402 0 0 1 719 882" Stroke="#59F3DCA9" StrokeThickness="28" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M212 512Q512 214 812 512Q512 810 212 512Z" Fill="#F7FAF4"/>
                                        <Ellipse Canvas.Left="368" Canvas.Top="368" Width="288" Height="288" Fill="#72C89B"/>
                                        <Ellipse Canvas.Left="430" Canvas.Top="430" Width="164" Height="164" Fill="#16483C"/>
                                        <Ellipse Canvas.Left="452" Canvas.Top="448" Width="56" Height="56" Fill="#F7FAF4"/>
                                        <Path Data="M708 305C759 302 804 325 830 369C778 375 733 352 708 305Z" Fill="#DDF2B6"/>
                                        <Path Data="M698 320C717 371 703 420 662 452C645 401 659 351 698 320Z" Fill="#B9E593"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="距离下次休息" Margin="0,24,0,8" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CountdownText" Text="20:00" FontFamily="Segoe UI Variable Display" FontSize="61" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CycleText" Text="每 20 分钟休息 20 秒" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,20,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="ToggleButton" Content="暂停计时" Style="{StaticResource PrimaryButton}" Click="ToggleButton_Click"/>
                            <Button Grid.Column="2" Content="重新计时" Style="{StaticResource GhostButton}" Click="ResetButton_Click"/>
                        </Grid>
                        <Button Grid.Row="2" Content="现在休息一下" Background="Transparent" BorderThickness="0" Foreground="#2D7A59" FontWeight="SemiBold" Padding="8" Click="BreakNowButton_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}" Background="#E9F3EC" Padding="22" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="20 · 20 · 20 护眼法" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="每使用屏幕 20 分钟，眺望 20 英尺（约 6 米）以外，至少 20 秒。" Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#52685F"/>
                        <TextBlock Text="坚持远眺能帮助眼睛放松调焦肌肉，减轻长时间近距离用眼带来的疲劳。" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#7A8A82"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="时间设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="专注时长" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                                <ComboBox x:Name="WorkMinutesBox" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Tag="1">1 分钟（测试）</ComboBoxItem>
                                    <ComboBoxItem Tag="20">20 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="30">30 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="45">45 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="60">60 分钟</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="休息时长" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                                <ComboBox x:Name="BreakSecondsBox" SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Tag="20">20 秒</ComboBoxItem>
                                    <ComboBoxItem Tag="30">30 秒</ComboBoxItem>
                                    <ComboBoxItem Tag="60">1 分钟</ComboBoxItem>
                                    <ComboBoxItem Tag="300">5 分钟</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#E7ECE8" Margin="0,20,0,16"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Windows 开机后自动启动" Foreground="{StaticResource Ink}" FontSize="14"
                                  Checked="Automation_Changed" Unchecked="Automation_Changed"/>
                        <CheckBox x:Name="ScheduleEnabledCheck" Content="仅在设定时间段工作" Margin="0,12,0,0" Foreground="{StaticResource Ink}" FontSize="14"
                                  Checked="Automation_Changed" Unchecked="Automation_Changed"/>
                        <Grid x:Name="SchedulePanel" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ActiveStartHourBox" SelectionChanged="Automation_Changed"/>
                            <TextBlock Grid.Column="1" Text="至" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ActiveEndHourBox" Grid.Column="2" SelectionChanged="Automation_Changed"/>
                        </Grid>
                        <TextBlock Text="结束后进入睡眠时段，到开始时间自动重新计时" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11" Foreground="#89948E"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="休息画面" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="ImageStatusText" Text="自然渐变背景" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="恢复默认" Background="Transparent" BorderThickness="0" Foreground="#708077" Click="DefaultImageButton_Click"/>
                        </Grid>
                        <Border Height="122" CornerRadius="16" Margin="0,16,0,14" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PreviewBackground">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#173C35" Offset="0"/><GradientStop Color="#5B9B73" Offset="0.55"/><GradientStop Color="#D2B67C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="PreviewHint" Text="让视线去远方" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Content="选择自己的图片" Style="{StaticResource GhostButton}" Click="ChooseImageButton_Click"/>
                        <TextBlock Text="支持 JPG、PNG、BMP；图片会铺满休息屏幕" Margin="2,10,0,0" FontSize="11" Foreground="#89948E"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 动漫花边装饰层：只在窗口边缘空白带，不遮任何文字；不拦截鼠标 -->
        <Grid IsHitTestVisible="False">
            <!-- 四角主花（贴角，34） -->
            <Image Source="{StaticResource SakuraPink}" Width="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0" Opacity="0.92"/>
            <Image Source="{StaticResource SakuraSoft}" Width="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Opacity="0.92"/>
            <Image Source="{StaticResource SakuraSoft}" Width="34" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8" Opacity="0.9"/>
            <Image Source="{StaticResource SakuraPink}" Width="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0.9"/>
            <!-- 左右边距中部点缀（边距内，安全） -->
            <Image Source="{StaticResource LeafDeco}" Width="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.8"/>
            <Image Source="{StaticResource Sparkle}" Width="20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Opacity="0.85"/>
            <!-- 顶部空白条点缀（标题/徽章上方） -->
            <Image Source="{StaticResource Sparkle}" Width="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="440,5,0,0" Opacity="0.8"/>
            <Image Source="{StaticResource SakuraSoft}" Width="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="560,9,0,0" Opacity="0.75"/>
            <!-- 底部空白条点缀（卡片下方） -->
            <Image Source="{StaticResource SakuraPink}" Width="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="450,0,0,8" Opacity="0.75"/>
            <Image Source="{StaticResource Sparkle}" Width="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="570,0,0,10" Opacity="0.8"/>
        </Grid>
    </Grid>
</Window>
